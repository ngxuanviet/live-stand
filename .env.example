# ============ BẮT BUỘC ============
# Mật khẩu đăng nhập trang Admin. Không dùng giá trị mẫu: server ở chế độ production sẽ từ chối chạy.
ADMIN_PASSWORD=doi-mat-khau-nay

# Chuỗi bí mật ký phiên đăng nhập (đặt chuỗi dài, ngẫu nhiên, ví dụ: openssl rand -base64 32)
SESSION_SECRET=doi-chuoi-ngau-nhien-dai

# ============ TUỲ CHỌN ============
# Địa chỉ công khai (không có dấu / cuối) để Dashboard tạo link Overlay cho OBS.
# Ví dụ khi dùng cloudflared: https://live.example.com
PUBLIC_BASE_URL=

# API key của sign server Euler Stream, nâng giới hạn kết nối TikTok (để trống = dùng gói miễn phí)
SIGN_API_KEY=

# Máy chủ ảnh avatar được phép tải thêm (phân tách dấu phẩy). Mặc định đã gồm các CDN của TikTok.
AVATAR_HOSTS=

# Bật = 1: tải danh sách quà để biết giá quà. Cần gói Business của Euler Stream; mặc định tắt
# (giá diamond vẫn lấy được từ chính event quà).
TIKTOK_EXTENDED_GIFT_INFO=0

# Bật = 1: ghi mẫu event thô của TikTok vào data/raw-events.jsonl (tối đa 30 mẫu mỗi loại) để kiểm tra trường dữ liệu
TIKTOK_DEBUG_LOG=0

# ============ CHỈ DÙNG VỚI DOCKER COMPOSE ============
# Địa chỉ và cổng mở trên máy chủ. Mặc định chỉ localhost (an toàn khi dùng cùng cloudflared).
# Muốn vào trực tiếp bằng IP của VPS: BIND_ADDR=0.0.0.0 (nên có HTTPS/tường lửa phía trước)
BIND_ADDR=127.0.0.1
HOST_PORT=3000

# Token của Cloudflare Tunnel (chỉ cần khi chạy: docker compose --profile tunnel up -d)
TUNNEL_TOKEN=

# ============ CHỈ DÙNG KHI CHẠY KHÔNG QUA DOCKER ============
PORT=3000
DB_PATH=./data/app.db
